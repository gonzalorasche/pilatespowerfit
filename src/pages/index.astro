---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import Method from '../components/Method.astro';
import Founder from '../components/Founder.astro';
import Classes from '../components/Classes.astro';
import SpecialClasses from '../components/SpecialClasses.astro';
import Testimonials from '../components/Testimonials.astro';
import Playlists from '../components/Playlists.astro';
import Social from '../components/Social.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import { wa } from '../data/site.js';
---

<Base>
  <Nav />

  <main id="main">
    <Hero />
    <Ticker />
    <Method />
    <Founder />
    <Classes />
    <SpecialClasses />
    <Testimonials />
    <Playlists />
    <Social />
    <CtaBand />
  </main>

  <Footer />

  <a class="wa-float" href={wa()} target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 3a9 9 0 00-7.7 13.7L3.2 21l4.4-1.1A9 9 0 1012 3z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <path d="M8.9 8.3c.3-.6.6-.6.9-.6h.6c.2 0 .4 0 .6.5l.7 1.7c.1.3 0 .5-.1.7l-.4.5c-.1.2-.2.3 0 .6.5.9 1.3 1.6 2.2 2 .3.2.5.1.6 0l.5-.6c.2-.2.4-.2.6-.1l1.6.8c.3.1.4.3.4.5 0 .7-.5 1.4-1.1 1.6-.5.2-1.2.2-3.4-.8a8.4 8.4 0 01-3.6-3.4c-.8-1.4-.8-2.5-.6-3z" fill="currentColor"/>
    </svg>
  </a>

  <style>
    .wa-float{
      position:fixed;
      right:clamp(.85rem,2.4vw,1.5rem);
      bottom:clamp(.85rem,2.4vw,1.5rem);
      z-index:95;
      width:52px; height:52px;
      display:grid;
      place-content:center;
      border-radius:50%;
      background:var(--lime);
      color:var(--ink);
      box-shadow:0 12px 30px rgba(0,0,0,.45);
      transition:transform .4s var(--ease-out), box-shadow .4s;
    }
    .wa-float svg{ width:25px; height:25px; }
    .wa-float:hover,
    .wa-float.is-hover{ transform:translateY(-3px) scale(1.05); box-shadow:0 18px 38px rgba(216,255,62,.28); }

    @media (max-height:520px) and (orientation:landscape){
      .wa-float{ width:44px; height:44px; }
      .wa-float svg{ width:21px; height:21px; }
    }
  </style>
</Base>
