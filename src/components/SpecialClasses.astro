---
import { specialClasses, statusLabels, specialTime, wa } from '../data/site.js';

const next = specialClasses.find((c) => c.status === 'open' || c.status === 'last') ?? specialClasses[0];
---

<section class="section special" id="especiales">
  <div class="special__aura" aria-hidden="true"></div>

  <div class="shell">
    <header class="special__head">
      <div class="special__head-main">
        <p class="eyebrow special__eyebrow" data-reveal>Ediciones limitadas</p>
        <h2 class="h-xl special__title" data-reveal style="--d:70ms">
          Clases<br /><span class="special__title-accent">especiales</span>
        </h2>
        <p class="lede special__lede" data-reveal style="--d:140ms">
          Fechas únicas, una playlist entera dedicada a un artista y una clase diseñada
          especialmente para ese set. Se anuncian, se llenan y no se repiten.
        </p>
        <p class="special__when" data-reveal style="--d:180ms">
          <span class="special__when-dot"></span>Siempre {specialTime.label}
        </p>
      </div>

      <aside class="countdown" data-reveal="right" style="--d:200ms" data-deadline={next.date + specialTime.iso}>
        <p class="countdown__label">Próxima edición</p>
        <p class="countdown__artist">{next.artist}</p>
        <div class="countdown__clock" id="cd">
          <div><b data-cd="d">--</b><span>días</span></div>
          <div><b data-cd="h">--</b><span>hs</span></div>
          <div><b data-cd="m">--</b><span>min</span></div>
          <div><b data-cd="s">--</b><span>seg</span></div>
        </div>
        <a class="btn btn--lime btn--sm countdown__cta" href={wa(`Hola! Quiero reservar mi lugar en la clase especial de ${next.artist}`)} target="_blank" rel="noopener">
          Reservar mi lugar <span class="btn__arrow">→</span>
        </a>
      </aside>
    </header>

    <ul class="special__rail">
      {specialClasses.map((c, i) => (
        <li class={`ticket ticket--${c.hue} is-${c.status}`} data-reveal style={`--d:${i * 90}ms`}>
          <div class="ticket__stub">
            <span class="ticket__date">{c.dateLabel}</span>
            <span class="ticket__time">{c.time}</span>
          </div>

          <div class="ticket__body">
            <span class={`pill pill--${c.status}`}>
              <span class="pill__dot"></span>{statusLabels[c.status]}
            </span>

            <h3 class="ticket__artist">{c.artist}</h3>
            <p class="ticket__edition">{c.edition}</p>
            <p class="ticket__blurb">{c.blurb}</p>

            <footer class="ticket__foot">
              {c.status === 'soldout' ? (
                <span class="ticket__closed">Agotada</span>
              ) : (
                <a
                  class="ticket__cta"
                  href={wa(`Hola! Quiero reservar mi lugar en la clase especial de ${c.artist} (${c.dateLabel})`)}
                  target="_blank"
                  rel="noopener"
                >
                  Reservar <span class="btn__arrow">→</span>
                </a>
              )}
            </footer>
          </div>
        </li>
      ))}
    </ul>

    <p class="special__note" data-reveal>
      ¿No querés perderte ninguna? Las fechas se anuncian primero en Instagram.
    </p>
  </div>
</section>

<style>
  .special{
    position:relative;
    overflow:hidden;
    background:
      radial-gradient(90% 70% at 50% -10%, rgba(255,61,138,.16), transparent 62%),
      linear-gradient(180deg,var(--ink) 0%, #0B0710 45%, var(--ink) 100%);
    border-block:1px solid var(--line-soft);
  }

  .special__aura{
    position:absolute;
    left:50%; top:-20%;
    width:min(120vw,1400px);
    aspect-ratio:2/1;
    transform:translateX(-50%);
    background:
      radial-gradient(closest-side, rgba(139,61,255,.24), transparent 70%),
      radial-gradient(closest-side at 70% 50%, rgba(255,61,138,.20), transparent 70%);
    filter:blur(50px);
    animation:drift 20s ease-in-out infinite;
    pointer-events:none;
  }

  .special__head{
    position:relative;
    display:grid;
    gap:clamp(1.8rem,4vw,3rem);
    padding-bottom:clamp(2.2rem,5vw,3.4rem);
  }

  .special__title{ margin-block:1rem .9rem; }

  .special__when{
    display:inline-flex;
    align-items:center;
    gap:.5rem;
    margin-top:1.1rem;
    padding:.42rem .9rem;
    border:1px solid var(--line);
    border-radius:100px;
    background:rgba(255,255,255,.03);
    font-size:.68rem;
    font-weight:700;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:var(--paper-dim);
  }
  .special__when-dot{
    width:6px; height:6px;
    border-radius:50%;
    background:var(--lime);
    animation:pulse-ring 2.4s ease-out infinite;
  }
  .special__title-accent{
    background:var(--grad-night);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
  }

  /* ---------- Countdown ---------- */
  .countdown{
    align-self:end;
    display:grid;
    gap:.8rem;
    justify-items:start;
    padding:clamp(1.1rem,2.6vw,1.6rem);
    border:1px solid var(--line);
    border-radius:var(--r-lg);
    background:rgba(13,13,18,.66);
    backdrop-filter:blur(16px);
  }
  .countdown__label{
    font-size:.64rem;
    font-weight:700;
    letter-spacing:.2em;
    text-transform:uppercase;
    color:var(--paper-faint);
  }
  .countdown__artist{
    font-family:var(--font-display);
    font-weight:800;
    font-size:clamp(1.8rem,1.1rem + 2.2vw,2.6rem);
    line-height:1;
    letter-spacing:.01em;
    text-transform:uppercase;
  }
  .countdown__clock{
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:.4rem;
    width:100%;
    margin-top:.15rem;
  }
  .countdown__clock div{
    display:grid;
    gap:.1rem;
    justify-items:center;
    padding:.55rem .2rem;
    border-radius:var(--r-sm);
    background:rgba(255,255,255,.04);
    border:1px solid var(--line-soft);
  }
  .countdown__clock b{
    font-family:var(--font-display);
    font-weight:800;
    font-size:clamp(1.35rem,1rem + 1.1vw,1.85rem);
    line-height:1;
    font-variant-numeric:tabular-nums;
  }
  .countdown__clock span{
    font-size:.57rem;
    font-weight:600;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--paper-faint);
  }
  .countdown__cta{ margin-top:.3rem; }

  /* ---------- Tickets ---------- */
  .special__rail{
    display:grid;
    gap:clamp(.9rem,2vw,1.2rem);
    grid-auto-rows:1fr;   /* todas las filas del mismo alto */
    align-items:stretch;
  }

  .ticket{
    --hue:var(--violet);
    position:relative;
    display:grid;
    grid-template-columns:auto 1fr;
    border:1px solid var(--line-soft);
    border-radius:var(--r-lg);
    background:linear-gradient(180deg,rgba(20,20,28,.9),rgba(10,10,14,.9));
    overflow:hidden;
    transition:transform .5s var(--ease-out), border-color .5s, box-shadow .5s;
  }
  .ticket--from-pink{ --hue:#FF3D8A; }
  .ticket--from-violet{ --hue:#8B3DFF; }
  .ticket--from-gold{ --hue:#F5C445; }
  .ticket--from-cyan{ --hue:#3DE0FF; }

  .ticket::after{
    content:'';
    position:absolute;
    left:0; top:0; bottom:0;
    width:3px;
    background:var(--hue);
    opacity:.85;
  }

  .ticket:hover,
  .ticket.is-hover{
    transform:translateY(-5px);
    border-color:color-mix(in srgb, var(--hue) 45%, transparent);
    box-shadow:0 24px 60px rgba(0,0,0,.55), 0 0 0 1px color-mix(in srgb, var(--hue) 22%, transparent);
  }

  .ticket.is-soldout{ opacity:.56; }
  .ticket.is-soldout:hover,
  .ticket.is-soldout.is-hover{ transform:none; box-shadow:none; }

  .ticket__stub{
    display:grid;
    align-content:center;
    justify-items:center;
    gap:.25rem;
    padding:1.2rem clamp(.8rem,2vw,1.3rem);
    min-width:clamp(96px,22vw,132px);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--hue) 20%, transparent), transparent 75%);
    border-right:1px dashed var(--line);
    text-align:center;
  }
  .ticket__date{
    font-family:var(--font-display);
    font-weight:800;
    font-size:clamp(1.15rem,.9rem + .8vw,1.45rem);
    line-height:1.05;
    letter-spacing:-.02em;
    text-transform:uppercase;
  }
  .ticket__time{
    font-size:.66rem;
    font-weight:600;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--paper-faint);
  }

  .ticket__body{
    display:grid;
    /* estado · artista · edicion · texto(crece) · pie
       asi todas las tarjetas alinean cada dato a la misma altura */
    grid-template-rows:auto auto auto 1fr auto;
    gap:.5rem;
    padding:clamp(1.1rem,2.6vw,1.6rem);
  }

  .pill{
    display:inline-flex;
    align-items:center;
    gap:.42rem;
    width:fit-content;
    padding:.28rem .62rem;
    border-radius:100px;
    border:1px solid var(--line);
    font-size:.6rem;
    font-weight:700;
    letter-spacing:.15em;
    text-transform:uppercase;
    color:var(--paper-dim);
  }
  .pill__dot{ width:5px; height:5px; border-radius:50%; background:currentColor; }
  .pill--open{ color:var(--lime); border-color:rgba(216,255,62,.32); }
  .pill--open .pill__dot{ animation:pulse-ring 2.2s ease-out infinite; }
  .pill--last{ color:#FFB13D; border-color:rgba(255,177,61,.34); }
  .pill--soldout{ color:var(--paper-faint); }
  .pill--soon{ color:var(--violet-soft); border-color:rgba(185,140,255,.32); }

  .ticket__artist{
    font-size:clamp(1.9rem,1.2rem + 2.2vw,2.9rem);
    line-height:.94;
    letter-spacing:.01em;
    text-transform:uppercase;
    margin-top:.1rem;
    min-height:1.88em;     /* reserva 2 renglones de nombre */
    display:flex;
    align-items:flex-start;
  }
  .ticket__edition{
    font-family:var(--font-display);
    font-weight:700;
    font-size:1.1rem;
    letter-spacing:.04em;
    text-transform:uppercase;
    color:var(--hue);
  }
  .ticket__blurb{
    font-size:.9rem;
    color:var(--paper-dim);
    line-height:1.55;
    max-width:52ch;
    align-self:start;
  }

  .ticket__foot{
    align-self:end;
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    justify-content:flex-end;
    gap:.7rem;
    margin-top:.5rem;
    padding-top:.8rem;
    border-top:1px solid var(--line-soft);
  }
  .ticket__cta{
    display:inline-flex;
    align-items:center;
    gap:.45rem;
    font-size:.72rem;
    font-weight:700;
    letter-spacing:.13em;
    text-transform:uppercase;
    color:var(--paper);
    padding-bottom:2px;
    border-bottom:1px solid var(--hue);
    transition:gap .35s var(--ease-out), color .3s;
  }
  .ticket__cta:hover,
  .ticket__cta:active,
  .ticket__cta:focus-visible,
  .ticket__cta.is-hover{ gap:.75rem; color:var(--hue); }
  .ticket__closed{
    font-size:.72rem;
    font-weight:700;
    letter-spacing:.13em;
    text-transform:uppercase;
    color:var(--paper-faint);
  }

  .special__note{
    margin-top:clamp(1.4rem,3vw,2rem);
    font-size:.8rem;
    letter-spacing:.06em;
    color:var(--paper-faint);
    text-align:center;
  }

  @media (min-width:760px){
    .special__rail{ grid-template-columns:repeat(2,1fr); }
  }

  @media (min-width:1060px){
    .special__head{ grid-template-columns:1.25fr .75fr; align-items:end; }
    .countdown{ justify-self:end; max-width:390px; width:100%; }
  }

  @media (max-width:420px){
    .ticket{ grid-template-columns:1fr; }
    .ticket__stub{
      flex-direction:row;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:.6rem;
      padding:.7rem 1.1rem;
      border-right:0;
      border-bottom:1px dashed var(--line);
      min-width:0;
    }
  }

  @media (max-height:560px) and (orientation:landscape) and (max-width:1000px){
    .special__rail{ grid-template-columns:repeat(2,1fr); }
    .ticket__blurb{ font-size:.82rem; }
  }
</style>

<script is:inline>
  (function () {
    var box = document.querySelector('.countdown');
    if (!box) return;
    var target = new Date(box.dataset.deadline).getTime();
    var f = {
      d: box.querySelector('[data-cd="d"]'),
      h: box.querySelector('[data-cd="h"]'),
      m: box.querySelector('[data-cd="m"]'),
      s: box.querySelector('[data-cd="s"]'),
    };
    var pad = function (n) { return String(n).padStart(2, '0'); };

    function tick() {
      var diff = target - Date.now();
      if (diff <= 0) {
        f.d.textContent = f.h.textContent = f.m.textContent = f.s.textContent = '00';
        clearInterval(timer);
        return;
      }
      var s = Math.floor(diff / 1000);
      f.d.textContent = pad(Math.floor(s / 86400));
      f.h.textContent = pad(Math.floor(s / 3600) % 24);
      f.m.textContent = pad(Math.floor(s / 60) % 60);
      f.s.textContent = pad(s % 60);
    }
    tick();
    var timer = setInterval(tick, 1000);
  })();
</script>
