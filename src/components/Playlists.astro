---
import { playlists } from '../data/site.js';
---

<section class="section lists">
  <div class="shell">
    <header class="lists__head">
      <div>
        <p class="eyebrow" data-reveal>La música manda</p>
        <h2 class="h-xl lists__title" data-reveal style="--d:70ms">Playlists<br />para entrenar</h2>
      </div>
      <p class="lists__note" data-reveal="right" style="--d:140ms">
        El ritmo de la clase está pensado como un set. Llevátelo a tu entrenamiento.
      </p>
    </header>

    <ul class="lists__grid">
      {playlists.map((p, i) => (
        <li data-reveal style={`--d:${i * 70}ms`}>
          <a class="disc" href={p.url} target="_blank" rel="noopener">
            <span class="disc__art">
              <img src={p.img} alt="" loading="lazy" width="500" height="500" />
              <span class="disc__play" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5-11-6.5z" fill="currentColor"/></svg>
              </span>
            </span>
            <span class="disc__meta">
              <span class="disc__name">{p.name}</span>
              <span class="disc__src">Spotify</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .lists{ background:var(--ink); }

  .lists__head{
    display:flex;
    flex-wrap:wrap;
    align-items:flex-end;
    justify-content:space-between;
    gap:1.4rem;
    padding-bottom:clamp(1.8rem,4vw,2.8rem);
  }
  .lists__title{ margin-top:1rem; }
  .lists__note{
    font-size:.92rem;
    color:var(--paper-dim);
    max-width:38ch;
  }

  .lists__grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    grid-auto-rows:1fr;
    gap:clamp(.7rem,1.8vw,1.1rem);
  }

  .disc{
    display:grid;
    grid-template-rows:auto 1fr;
    gap:.7rem;
    height:100%;
    transition:transform .5s var(--ease-out);
  }
  .disc:hover,
  .disc.is-hover{ transform:translateY(-5px); }

  .disc__art{
    position:relative;
    display:block;
    aspect-ratio:1;
    border-radius:var(--r-md);
    overflow:hidden;
    background:var(--ink-3);
    border:1px solid var(--line-soft);
  }
  .disc__art img{
    width:100%; height:100%;
    object-fit:cover;
    filter:grayscale(1) brightness(.8);
    transition:transform .8s var(--ease-out), filter .5s;
  }
  .disc:hover .disc__art img,
  .disc.is-hover .disc__art img{ transform:scale(1.07); filter:grayscale(0) brightness(.95); }

  .disc__play{
    position:absolute;
    right:.6rem; bottom:.6rem;
    width:38px; height:38px;
    display:grid;
    place-content:center;
    border-radius:50%;
    background:var(--lime);
    color:var(--ink);
    transform:translateY(8px) scale(.85);
    opacity:0;
    transition:opacity .4s var(--ease-out), transform .45s var(--ease-out);
  }
  .disc__play svg{ width:17px; height:17px; margin-left:1px; }
  .disc:hover .disc__play,
  .disc:focus-visible .disc__play,
  .disc.is-hover .disc__play{ opacity:1; transform:translateY(0) scale(1); }

  .disc__meta{ display:grid; gap:.1rem; align-content:start; }
  .disc__name{
    font-family:var(--font-display);
    font-weight:700;
    font-size:1.2rem;
    text-transform:uppercase;
    letter-spacing:.02em;
  }
  .disc__src{
    font-size:.62rem;
    font-weight:600;
    letter-spacing:.17em;
    text-transform:uppercase;
    color:var(--paper-faint);
  }

  @media (min-width:640px){ .lists__grid{ grid-template-columns:repeat(3,1fr); } }
  @media (min-width:1000px){ .lists__grid{ grid-template-columns:repeat(5,1fr); } }

  @media (max-height:560px) and (orientation:landscape) and (max-width:1000px){
    .lists__grid{ grid-template-columns:repeat(5,1fr); }
    .disc__play{ width:30px; height:30px; }
  }
</style>
