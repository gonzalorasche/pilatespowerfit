---
import { site, igGrid } from '../data/site.js';
---

<section class="section social" id="comunidad">
  <div class="shell">
    <header class="social__head">
      <div class="social__id" data-reveal>
        <span class="social__avatar">
          <img src="/media/appleicon.png" alt="" width="120" height="120" loading="lazy" />
        </span>
        <div>
          <a class="social__handle" href={site.instagram} target="_blank" rel="noopener">
            {site.instagramHandle}
          </a>
          <p class="social__sub">Clases, fechas especiales y detrás de escena</p>
        </div>
      </div>

      <h2 class="h-xl social__title" data-reveal style="--d:80ms">
        Seguí el<br /><span class="grad-text">movimiento</span>
      </h2>

      <a class="btn social__cta" href={site.instagram} target="_blank" rel="noopener" data-reveal style="--d:160ms">
        Seguir en Instagram <span class="btn__arrow">→</span>
      </a>
    </header>

    <ul class="social__grid">
      {igGrid.map((p, i) => (
        <li data-reveal="zoom" style={`--d:${i * 70}ms`}>
          <a class="post" href={site.instagram} target="_blank" rel="noopener" aria-label={`Ver en Instagram: ${p.caption}`}>
            <img src={p.img} alt="" loading="lazy" width="600" height="600" />
            <span class="post__veil">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.7"/>
                <circle cx="12" cy="12" r="4.1" fill="none" stroke="currentColor" stroke-width="1.7"/>
                <circle cx="17.3" cy="6.7" r="1.15" fill="currentColor"/>
              </svg>
              <span class="post__caption">{p.caption}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .social{
    background:
      radial-gradient(70% 55% at 85% 8%, rgba(139,61,255,.16), transparent 62%),
      var(--ink);
    border-top:1px solid var(--line-soft);
  }

  .social__head{
    display:grid;
    gap:1.2rem;
    justify-items:start;
    padding-bottom:clamp(1.8rem,4vw,2.8rem);
  }

  .social__id{ display:flex; align-items:center; gap:.9rem; }
  .social__avatar{
    width:52px; height:52px;
    display:grid;
    place-content:center;
    border-radius:50%;
    padding:2px;
    background:var(--grad-night);
    flex:none;
  }
  .social__avatar img{
    width:100%; height:100%;
    border-radius:50%;
    object-fit:cover;
    background:var(--ink);
  }
  .social__handle{
    font-family:var(--font-display);
    font-weight:800;
    font-size:clamp(1.35rem,1.1rem + 1vw,1.7rem);
    letter-spacing:.01em;
    transition:color .3s;
  }
  .social__handle:hover,
  .social__handle.is-hover{ color:var(--violet-soft); }
  .social__sub{
    font-size:.78rem;
    color:var(--paper-faint);
    letter-spacing:.04em;
  }

  .social__grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:clamp(.45rem,1.4vw,.8rem);
  }

  .post{
    position:relative;
    display:block;
    aspect-ratio:1;
    border-radius:var(--r-md);
    overflow:hidden;
    background:var(--ink-3);
  }
  .post img{
    width:100%; height:100%;
    object-fit:cover;
    filter:grayscale(1) brightness(.78);
    transition:transform .8s var(--ease-out), filter .55s;
  }
  .post:hover img,
  .post.is-hover img{ transform:scale(1.07); filter:grayscale(0) brightness(.95); }

  .post__veil{
    position:absolute;
    inset:0;
    display:grid;
    align-content:end;
    gap:.45rem;
    padding:clamp(.6rem,1.6vw,.9rem);
    background:linear-gradient(180deg,transparent 42%,rgba(7,7,10,.86));
    opacity:0;
    transition:opacity .45s var(--ease-out);
  }
  .post:hover .post__veil,
  .post:focus-visible .post__veil,
  .post.is-hover .post__veil{ opacity:1; }
  .post__veil svg{ width:20px; height:20px; color:var(--lime); }
  .post__caption{
    font-size:.72rem;
    font-weight:600;
    letter-spacing:.05em;
    color:var(--paper);
    line-height:1.3;
  }

  @media (min-width:700px){
    .social__head{
      grid-template-columns:1fr auto;
      align-items:end;
      row-gap:1.6rem;
    }
    .social__id{ grid-column:1 / -1; }
    .social__grid{ grid-template-columns:repeat(3,1fr); }
  }

  @media (min-width:1060px){
    .social__grid{ grid-template-columns:repeat(6,1fr); }
  }

  @media (max-height:560px) and (orientation:landscape) and (max-width:1000px){
    .social__grid{ grid-template-columns:repeat(6,1fr); }
  }
</style>
