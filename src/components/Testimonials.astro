---
import { testimonials } from '../data/site.js';
---

<section class="section quotes" id="opiniones">
  <div class="shell">
    <header class="quotes__head">
      <div>
        <p class="eyebrow" data-reveal>Experiencias reales</p>
        <h2 class="h-xl quotes__title" data-reveal style="--d:70ms">
          Lo dicen<br />los que <span class="grad-text">entrenan</span>
        </h2>
      </div>
      <div class="quotes__nav" data-reveal="right">
        <button class="rail-btn" data-dir="-1" aria-label="Testimonio anterior">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="rail-btn" data-dir="1" aria-label="Testimonio siguiente">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </header>
  </div>

  <div class="quotes__rail" id="quotesRail" tabindex="0" role="region" aria-label="Testimonios de alumnos">
    <div class="quotes__pad" aria-hidden="true"></div>
    {testimonials.map((t) => (
      <article class="quote">
        <header class="quote__who">
          <span class="quote__avatar">
            <img src={t.img} alt={`${t.name}, alumno de Pilates Power Fit`} loading="lazy" width="160" height="160" />
          </span>
          <span class="quote__id">
            <span class="quote__name">{t.name}</span>
            <span class="quote__time">{t.time}</span>
          </span>
          <span class="quote__mark" aria-hidden="true">”</span>
        </header>
        <p class="quote__text">{t.text}</p>
      </article>
    ))}
    <div class="quotes__pad" aria-hidden="true"></div>
  </div>
</section>

<style>
  .quotes{
    background:linear-gradient(180deg,var(--ink),var(--ink-2) 55%,var(--ink));
    overflow:hidden;
  }

  .quotes__head{
    display:flex;
    flex-wrap:wrap;
    align-items:flex-end;
    justify-content:space-between;
    gap:1.5rem;
    padding-bottom:clamp(1.8rem,4vw,2.8rem);
  }
  .quotes__title{ margin-top:1rem; }

  .quotes__nav{ display:flex; gap:.5rem; margin-left:auto; }
  .rail-btn{
    width:46px; height:46px;
    display:grid;
    place-content:center;
    border:1px solid var(--line);
    border-radius:50%;
    color:var(--paper);
    background:rgba(255,255,255,.03);
    transition:background .35s, border-color .35s, transform .35s var(--ease-out);
  }
  .rail-btn svg{ width:19px; height:19px; }
  .rail-btn:hover,
  .rail-btn.is-hover{ background:var(--paper); color:var(--ink); border-color:transparent; transform:translateY(-2px); }

  .quotes__rail{
    display:flex;
    gap:clamp(.8rem,2vw,1.2rem);
    overflow-x:auto;
    scroll-snap-type:x mandatory;
    scroll-behavior:smooth;
    scrollbar-width:none;
    padding-block:.4rem 1.2rem;
    cursor:grab;
  }
  .quotes__rail::-webkit-scrollbar{ display:none; }
  .quotes__rail.is-dragging{ cursor:grabbing; scroll-snap-type:none; scroll-behavior:auto; }

  .quotes__pad{ flex:none; width:calc(var(--gutter) - clamp(.8rem,2vw,1.2rem)); min-width:.2rem; }

  .quote{
    flex:none;
    scroll-snap-align:center;
    width:min(82vw,380px);
    display:grid;
    grid-template-rows:auto 1fr;   /* cabecera fija arriba, texto abajo */
    gap:1rem;
    padding:clamp(1.2rem,2.6vw,1.6rem);
    border:1px solid var(--line-soft);
    border-radius:var(--r-lg);
    background:var(--ink-2);
    transition:border-color .45s, transform .5s var(--ease-out);
  }
  .quote:hover,
  .quote.is-hover{ border-color:var(--line); transform:translateY(-4px); }

  .quote__who{
    display:flex;
    align-items:center;
    gap:.85rem;
  }

  .quote__avatar{
    flex:none;
    width:60px; height:60px;
    border-radius:50%;
    overflow:hidden;
    background:var(--ink-3);
    border:1px solid var(--line);
    padding:2px;
  }
  .quote__avatar img{
    width:100%; height:100%;
    border-radius:50%;
    object-fit:cover;
    object-position:center 22%;
    filter:grayscale(1) contrast(1.06);
    transition:filter .5s var(--ease-out);
  }
  .quote:hover .quote__avatar img,
  .quote.is-hover .quote__avatar img{ filter:grayscale(0); }

  .quote__id{ display:grid; gap:.1rem; min-width:0; }

  .quote__name{
    font-family:var(--font-display);
    font-weight:800;
    font-size:1.4rem;
    line-height:1;
    text-transform:uppercase;
    letter-spacing:.02em;
  }
  .quote__time{
    font-size:.64rem;
    font-weight:600;
    letter-spacing:.15em;
    text-transform:uppercase;
    color:var(--paper-faint);
  }

  .quote__mark{
    margin-left:auto;
    align-self:flex-start;
    font-family:var(--font-display);
    font-size:3.4rem;
    line-height:.6;
    color:var(--violet);
    opacity:.35;
  }

  .quote__text{
    align-self:start;
    font-size:.94rem;
    line-height:1.6;
    color:var(--paper-dim);
    padding-top:.9rem;
    border-top:1px solid var(--line-soft);
  }

  @media (min-width:900px){
    .quote{ width:370px; }
  }

  @media (max-height:560px) and (orientation:landscape) and (max-width:1000px){
    .quote{ width:min(52vw,340px); gap:.7rem; padding:1rem; }
    .quote__avatar{ width:48px; height:48px; }
    .quote__name{ font-size:1.2rem; }
    .quote__text{ font-size:.82rem; padding-top:.7rem; }
  }
</style>

<script is:inline>
  (function () {
    var rail = document.getElementById('quotesRail');
    if (!rail) return;

    document.querySelectorAll('.quotes__nav .rail-btn').forEach(function (b) {
      b.addEventListener('click', function () {
        var card = rail.querySelector('.quote');
        var step = card ? card.offsetWidth + 16 : rail.clientWidth * 0.8;
        rail.scrollBy({ left: step * Number(b.dataset.dir), behavior: 'smooth' });
      });
    });

    var down = false, startX = 0, startScroll = 0, moved = 0;
    rail.addEventListener('pointerdown', function (e) {
      if (e.pointerType === 'touch') return;
      down = true; moved = 0;
      startX = e.clientX;
      startScroll = rail.scrollLeft;
      rail.classList.add('is-dragging');
    });
    window.addEventListener('pointermove', function (e) {
      if (!down) return;
      var dx = e.clientX - startX;
      moved = Math.abs(dx);
      rail.scrollLeft = startScroll - dx;
    });
    window.addEventListener('pointerup', function () {
      if (!down) return;
      down = false;
      rail.classList.remove('is-dragging');
    });
    rail.addEventListener('click', function (e) {
      if (moved > 6) { e.preventDefault(); e.stopPropagation(); }
    }, true);
  })();
</script>
