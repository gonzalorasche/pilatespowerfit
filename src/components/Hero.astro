---
import { wa } from '../data/site.js';

const words = ['ESTO', 'NO ES', 'PILATES.'];
---

<section class="hero" id="top">
  <div class="hero__bg" aria-hidden="true">
    <video
      class="hero__video"
      src="/media/video2.MP4"
      poster="/media/hero2.webp"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    ></video>
    <div class="hero__scrim"></div>
    <div class="hero__vignette"></div>
  </div>

  <div class="hero__inner shell">
    <p class="eyebrow hero__eyebrow">Colegiales · CABA · Método Power Fit</p>

    <h1 class="h-mega hero__title">
      {words.map((w, i) => (
        <span class="hero__line"><span class="hero__word" style={`--i:${i}`}>{w}</span></span>
      ))}
      <span class="hero__line">
        <span class="hero__word hero__word--accent" style="--i:3">ES POWER.</span>
      </span>
    </h1>

    <p class="lede hero__lede">
      Un entrenamiento exigente de fuerza, cardio y movilidad para quienes
      necesitan ir más allá del pilates tradicional.
    </p>

    <div class="hero__actions">
      <a class="btn btn--lime" href={wa()} target="_blank" rel="noopener">
        Reservar clase de prueba <span class="btn__arrow">→</span>
      </a>
      <a class="btn btn--ghost" href="#metodo">Ver el método</a>
    </div>
  </div>

  <div class="hero__foot shell">
    <a class="hero__scroll" href="#metodo" aria-label="Bajar a la sección método">
      <span class="hero__scroll-track"><span class="hero__scroll-dot"></span></span>
      <span class="hero__scroll-label">Scroll</span>
    </a>
    <p class="hero__note">Lunes y jueves · Grupos reducidos</p>
  </div>
</section>

<style>
  .hero{
    position:relative;
    min-height:100svh;
    display:flex;
    flex-direction:column;
    justify-content:flex-end;
    padding-top:calc(var(--nav-h) + 2rem);
    padding-bottom:clamp(1.4rem,4vh,2.6rem);
    overflow:hidden;
    isolation:isolate;
  }

  .hero__bg{ position:absolute; inset:0; z-index:-1; }

  .hero__video{
    width:100%; height:100%;
    object-fit:cover;
    filter:grayscale(1) contrast(1.16) brightness(.72);
    animation:slow-zoom 22s var(--ease-out) infinite alternate;
  }

  .hero__scrim{
    position:absolute; inset:0;
    background:
      linear-gradient(180deg, rgba(7,7,10,.85) 0%, rgba(7,7,10,.34) 32%, rgba(7,7,10,.92) 88%, var(--ink) 100%),
      radial-gradient(70% 60% at 14% 82%, rgba(139,61,255,.30), transparent 72%);
  }

  .hero__vignette{
    position:absolute; inset:0;
    background:radial-gradient(120% 90% at 50% 45%, transparent 38%, rgba(7,7,10,.72) 100%);
  }

  .hero__inner{
    position:relative;
    /* 1 0 auto: puede crecer, nunca encogerse por debajo de su contenido.
       Si algo no entra el hero se estira en vez de recortar el pie. */
    flex:1 0 auto;
    display:flex;
    flex-direction:column;
    justify-content:flex-end;
    gap:clamp(1rem,2.4vh,1.6rem);
    padding-bottom:clamp(1.6rem,5vh,3rem);
  }

  .hero__eyebrow{
    opacity:0;
    animation:fade-in .9s var(--ease-out) .15s forwards;
  }

  .hero__title{
    max-width:18ch;
    /* flex evita que los margin negativos de .hero__line se colapsen
       entre si (si no, cada renglon suma aire de mas) */
    display:flex;
    flex-direction:column;
    /* El titulo son 4 renglones: si el tamano dependiera solo del ancho,
       en pantallas anchas y bajas (notebooks) el hero no entra entero.
       El segundo termino reserva el alto del resto del hero (eyebrow,
       lede, botones y pie) y reparte lo que sobra entre los 4 renglones. */
    /* Son 4 renglones. Con el tamano atado solo al ancho, en notebooks
       (1366x768, 1440x900) el hero pedia ~1139px de alto y el pie quedaba
       cortado. El 2do termino deja el titulo lo mas grande posible sin
       pasarse: ~86svh es lo que queda tras eyebrow, lede, botones y pie.
       En monitores grandes no llega a activarse y manda el 13rem de antes. */
    font-size:clamp(3.6rem, min(1rem + 15vw, (86svh - 305px) / 3.6), 13rem);
  }

  .hero__line{
    display:block;
    overflow:hidden;
    /* line-height .82 deja el line box mas corto que los glifos de
       Big Shoulders: sin este aire la mascara recorta las curvas de S y R.
       El margin negativo devuelve el interlineado original. */
    padding-block:.2em;
    margin-block:-.18em;
  }

  .hero__word{
    display:inline-block;
    white-space:nowrap;
    /* 102% alcanzaba con la mascara justa; ahora que tiene padding
       hay que empujar la palabra mas abajo para que no asome. */
    transform:translateY(140%) skewY(3deg);
    animation:rise .95s var(--ease-power) forwards;
    animation-delay:calc(var(--i) * 105ms + 220ms);
  }

  .hero__word--accent{
    background:var(--grad-power);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
  }

  @keyframes rise{
    to{ transform:translateY(0) skewY(0); }
  }
  @keyframes fade-in{
    to{ opacity:1; }
  }

  .hero__lede{
    opacity:0;
    animation:fade-in .9s var(--ease-out) .72s forwards;
  }

  .hero__actions{
    display:flex;
    flex-wrap:wrap;
    gap:.7rem;
    opacity:0;
    animation:fade-in .9s var(--ease-out) .88s forwards;
  }

  .hero__foot{
    position:relative;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:1rem;
    padding-top:1rem;
    border-top:1px solid var(--line-soft);
    opacity:0;
    animation:fade-in .9s var(--ease-out) 1.05s forwards;
  }

  .hero__scroll{
    display:inline-flex;
    align-items:center;
    gap:.7rem;
    font-size:.66rem;
    font-weight:600;
    letter-spacing:.24em;
    text-transform:uppercase;
    color:var(--paper-dim);
    transition:color .3s;
  }
  .hero__scroll:hover,
  .hero__scroll.is-hover{ color:var(--paper); }

  .hero__scroll-track{
    position:relative;
    width:1px; height:34px;
    background:var(--line);
    overflow:hidden;
    flex:none;
  }
  .hero__scroll-dot{
    position:absolute;
    left:-1px; top:0;
    width:3px; height:12px;
    background:var(--lime);
    border-radius:2px;
    animation:scroll-run 2.1s var(--ease-power) infinite;
  }
  @keyframes scroll-run{
    0%{ transform:translateY(-14px); opacity:0; }
    30%{ opacity:1; }
    100%{ transform:translateY(34px); opacity:0; }
  }

  .hero__note{
    font-size:.68rem;
    font-weight:600;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:var(--paper-faint);
    text-align:right;
  }

  /* ---------- Tablet ---------- */
  @media (min-width:768px){
    .hero__title{ max-width:none; }
    .hero__lede{ font-size:1.14rem; }
  }

  /* ---------- Mobile landscape: dos columnas para no desbordar ---------- */
  @media (max-height:560px) and (orientation:landscape){
    .hero{
      --nav-h:58px;
      min-height:100svh;
      padding-top:calc(var(--nav-h) + .5rem);
      padding-bottom:.6rem;
    }
    .hero__inner{
      display:grid;
      grid-template-columns:1.12fr .88fr;
      grid-template-areas:
        "eyebrow eyebrow"
        "title   lede"
        "title   actions";
      align-items:end;
      column-gap:clamp(1rem,3vw,2rem);
      row-gap:.5rem;
      padding-bottom:.6rem;
    }
    .hero__eyebrow{ grid-area:eyebrow; }
    .hero__title{ grid-area:title; align-self:end; font-size:clamp(2.2rem,7.2vw,3.9rem); }
    .hero__lede{ grid-area:lede; align-self:end; font-size:.84rem; max-width:40ch; }
    .hero__actions{ grid-area:actions; }
    .hero__actions .btn{ padding:.7em 1.15em; font-size:.7rem; }
    .hero__foot{ padding-top:.45rem; }
    .hero__scroll-track{ height:18px; }
    .hero__note{ font-size:.6rem; }
  }

  /* Landscape muy angosto: vuelve a una columna */
  @media (max-height:560px) and (orientation:landscape) and (max-width:620px){
    .hero__inner{
      grid-template-columns:1fr;
      grid-template-areas:"eyebrow" "title" "lede" "actions";
    }
    .hero__foot{ display:none; }
  }

  @media (max-width:420px){
    .hero__actions .btn{ flex:1 1 100%; }
    .hero__note{ display:none; }
    .hero__foot{ justify-content:flex-start; }
  }

  @media (prefers-reduced-motion: reduce){
    .hero__word{ transform:none; animation:none; }
    .hero__eyebrow,.hero__lede,.hero__actions,.hero__foot{ opacity:1; animation:none; }
  }
</style>
