---
import { wa } from '../data/site.js';
---

<section class="band">
  <div class="band__bg" aria-hidden="true">
    <img src="/media/hero3.webp" alt="" loading="lazy" data-parallax="0.08" />
    <span class="band__scrim"></span>
  </div>

  <div class="shell band__inner">
    <h2 class="h-mega band__title" data-reveal>
      Empezá<br /><span class="outline-text">hoy</span>
    </h2>
    <div class="band__side" data-reveal style="--d:120ms">
      <p class="lede">
        Escribinos y coordinamos tu primera clase. Contanos tu nivel y desde dónde venís:
        el resto lo armamos nosotros.
      </p>
      <a class="btn btn--lime" href={wa()} target="_blank" rel="noopener">
        Escribir por WhatsApp <span class="btn__arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .band{
    position:relative;
    overflow:hidden;
    padding-block:clamp(4rem,10vh,7.5rem);
    isolation:isolate;
  }

  .band__bg{ position:absolute; inset:0; z-index:-1; }
  .band__bg img{
    width:100%; height:118%;
    object-fit:cover;
    filter:grayscale(1) contrast(1.1) brightness(.5);
    transform:translate3d(0,var(--py,0px),0);
  }
  .band__scrim{
    position:absolute; inset:0;
    background:
      linear-gradient(180deg,var(--ink) 0%, rgba(7,7,10,.6) 30%, rgba(7,7,10,.72) 70%, var(--ink) 100%),
      radial-gradient(60% 70% at 80% 40%, rgba(139,61,255,.28), transparent 70%);
  }

  .band__inner{
    display:grid;
    gap:clamp(1.4rem,4vw,3rem);
    align-items:end;
  }

  .band__title{ letter-spacing:-.045em; }

  .band__side{ display:grid; gap:1.2rem; justify-items:start; }

  @media (min-width:900px){
    .band__inner{ grid-template-columns:1fr .85fr; }
  }

  @media (max-height:560px) and (orientation:landscape) and (max-width:1000px){
    .band{ padding-block:2.6rem; }
    .band__inner{ grid-template-columns:1fr .9fr; }
    .band__title{ font-size:clamp(2.2rem,8vw,3.6rem); }
  }
</style>
