---
import { site, navLinks, wa } from '../data/site.js';
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="shell foot__inner">
    <div class="foot__brand">
      <img src="/media/logo.png" alt="Pilates Power Fit" width="180" height="48" loading="lazy" />
      <p class="foot__claim">Esto no es pilates tradicional. Es Power.</p>
      <p class="foot__addr">{site.address}</p>
    </div>

    <nav class="foot__nav" aria-label="Pie de página">
      <p class="foot__label">Navegación</p>
      {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="foot__contact">
      <p class="foot__label">Contacto</p>
      <a class="foot__link" href={site.instagram} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.7"/>
          <circle cx="12" cy="12" r="4.1" fill="none" stroke="currentColor" stroke-width="1.7"/>
          <circle cx="17.3" cy="6.7" r="1.15" fill="currentColor"/>
        </svg>
        {site.instagramHandle}
      </a>
      <a class="foot__link" href={wa()} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3a9 9 0 00-7.7 13.7L3.2 21l4.4-1.1A9 9 0 1012 3z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
          <path d="M8.9 8.3c.3-.6.6-.6.9-.6h.6c.2 0 .4 0 .6.5l.7 1.7c.1.3 0 .5-.1.7l-.4.5c-.1.2-.2.3 0 .6.5.9 1.3 1.6 2.2 2 .3.2.5.1.6 0l.5-.6c.2-.2.4-.2.6-.1l1.6.8c.3.1.4.3.4.5 0 .7-.5 1.4-1.1 1.6-.5.2-1.2.2-3.4-.8a8.4 8.4 0 01-3.6-3.4c-.8-1.4-.8-2.5-.6-3z" fill="currentColor"/>
        </svg>
        WhatsApp
      </a>
    </div>
  </div>

  <div class="shell foot__base">
    <p>© {year} {site.name} · Todos los derechos reservados</p>
    <a class="foot__agency" href={site.agency.url} target="_blank" rel="noopener">
      <span>Web creada por</span>
      <img src="/media/logo_nav.png" alt={site.agency.name} width="90" height="24" loading="lazy" />
    </a>
  </div>
</footer>

<style>
  .foot{
    background:var(--ink-2);
    border-top:1px solid var(--line-soft);
    padding-top:clamp(2.6rem,6vw,4.5rem);
  }

  .foot__inner{
    display:grid;
    gap:clamp(2rem,4vw,3rem);
    padding-bottom:clamp(2rem,4vw,3rem);
  }

  .foot__brand img{ height:clamp(30px,4vw,38px); width:auto; }
  .foot__claim{
    margin-top:1rem;
    font-family:var(--font-display);
    font-weight:700;
    font-size:clamp(1.3rem,1.1rem + .8vw,1.6rem);
    line-height:1.2;
    letter-spacing:.015em;
    text-transform:uppercase;
    max-width:24ch;
  }
  .foot__addr{
    margin-top:.5rem;
    font-size:.82rem;
    color:var(--paper-faint);
  }

  .foot__label{
    font-size:.62rem;
    font-weight:700;
    letter-spacing:.2em;
    text-transform:uppercase;
    color:var(--paper-faint);
    margin-bottom:.9rem;
  }

  .foot__nav{ display:grid; gap:.5rem; align-content:start; }
  .foot__nav a{
    font-size:.88rem;
    color:var(--paper-dim);
    width:fit-content;
    transition:color .3s, transform .35s var(--ease-out);
  }
  .foot__nav a:hover,
  .foot__nav a.is-hover{ color:var(--paper); transform:translateX(3px); }

  .foot__contact{ display:grid; gap:.6rem; align-content:start; }
  .foot__link{
    display:inline-flex;
    align-items:center;
    gap:.55rem;
    font-size:.88rem;
    color:var(--paper-dim);
    width:fit-content;
    transition:color .3s;
  }
  .foot__link svg{ width:17px; height:17px; }
  .foot__link:hover,
  .foot__link.is-hover{ color:var(--lime); }

  .foot__base{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    justify-content:space-between;
    gap:1rem;
    padding-block:1.1rem;
    border-top:1px solid var(--line-soft);
    font-size:.72rem;
    color:var(--paper-faint);
  }

  .foot__agency{
    display:inline-flex;
    align-items:center;
    gap:.55rem;
    font-size:.62rem;
    letter-spacing:.16em;
    text-transform:uppercase;
    opacity:.72;
    transition:opacity .3s;
  }
  .foot__agency:hover,
  .foot__agency.is-hover{ opacity:1; }
  .foot__agency img{ height:18px; width:auto; }

  @media (min-width:760px){
    .foot__inner{ grid-template-columns:1.4fr .8fr .8fr; }
  }
</style>
