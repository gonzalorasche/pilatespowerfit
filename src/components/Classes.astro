---
import { classCards, site, wa } from '../data/site.js';
---

<section class="section classes" id="clases">
  <div class="shell">
    <header class="classes__head">
      <div>
        <p class="eyebrow" data-reveal>Entrenar acá</p>
        <h2 class="h-xl" data-reveal style="--d:70ms">Clases<br />presenciales</h2>
      </div>
      <p class="lede" data-reveal="right" style="--d:140ms">
        Grupos reducidos en Colegiales, lunes y jueves. Elegí cómo querés empezar:
        una clase suelta para probar o un pack mensual para ver progreso real.
      </p>
    </header>

    <ul class="classes__grid">
      {classCards.map((c, i) => (
        <li class={`plan${c.featured ? ' plan--featured' : ''}`} data-reveal style={`--d:${i * 100}ms`}>
          <span class="plan__tag">{c.tag}</span>
          <h3 class="h-lg plan__title">{c.title}</h3>
          <p class="plan__price">{c.price}</p>
          <ul class="plan__features">
            {c.features.map((f) => (
              <li>
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path d="M2.5 8.4l3.4 3.4 7.6-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {f}
              </li>
            ))}
          </ul>
          <a class={`btn ${c.featured ? 'btn--lime' : 'btn--ghost'} plan__cta`} href={wa(c.waMsg)} target="_blank" rel="noopener">
            {c.cta} <span class="btn__arrow">→</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="place" data-reveal>
      <div class="place__info">
        <p class="eyebrow">Dónde</p>
        <h3 class="h-lg place__title">{site.address}</h3>
        <p class="place__text">
          Un espacio preparado para entrenar fuerte: pisos amplios, equipamiento completo
          y grupos chicos para que nadie entrene sin corrección.
        </p>
        <a class="btn btn--ghost btn--sm" href="https://www.google.com/maps/search/?api=1&query=Pilates+Power+Fit+Colegiales+CABA" target="_blank" rel="noopener">
          Cómo llegar <span class="btn__arrow">→</span>
        </a>
      </div>
      <div class="place__map">
        <iframe
          src={site.mapEmbed}
          title="Ubicación de Pilates Power Fit en Colegiales, CABA"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .classes{ background:var(--ink); }

  .classes__head{
    display:grid;
    gap:clamp(1.2rem,3vw,3rem);
    padding-bottom:clamp(2.2rem,5vw,3.6rem);
  }
  .classes__head .eyebrow{ margin-bottom:1rem; display:inline-flex; }

  .classes__grid{
    display:grid;
    gap:clamp(.9rem,2vw,1.3rem);
    grid-auto-rows:1fr;
    align-items:stretch;
  }

  .plan{
    position:relative;
    display:grid;
    /* etiqueta · titulo · precio · features(crece) · boton
       para que todo quede a la misma altura entre tarjetas */
    grid-template-rows:auto auto auto 1fr auto;
    gap:.85rem;
    padding:clamp(1.4rem,3vw,2rem);
    border:1px solid var(--line-soft);
    border-radius:var(--r-lg);
    background:linear-gradient(180deg,var(--ink-2),var(--ink));
    overflow:hidden;
    transition:transform .5s var(--ease-out), border-color .5s, box-shadow .5s;
  }
  .plan::before{
    content:'';
    position:absolute;
    inset:-1px;
    border-radius:inherit;
    padding:1px;
    background:var(--grad-power);
    -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
    -webkit-mask-composite:xor;
    mask-composite:exclude;
    opacity:0;
    transition:opacity .5s var(--ease-out);
    pointer-events:none;
  }
  .plan:hover,
  .plan.is-hover{ transform:translateY(-6px); box-shadow:0 26px 60px rgba(0,0,0,.5); }
  .plan:hover::before,
  .plan.is-hover::before{ opacity:1; }

  .plan--featured{
    background:
      radial-gradient(120% 90% at 100% 0%, rgba(139,61,255,.22), transparent 62%),
      linear-gradient(180deg,var(--ink-3),var(--ink));
    border-color:var(--line);
  }

  .plan__tag{
    display:inline-flex;
    width:fit-content;
    padding:.34rem .7rem;
    border-radius:100px;
    border:1px solid var(--line);
    font-size:.62rem;
    font-weight:700;
    letter-spacing:.17em;
    text-transform:uppercase;
    color:var(--paper-dim);
  }
  .plan--featured .plan__tag{
    background:var(--lime);
    border-color:transparent;
    color:var(--ink);
  }

  .plan__title{
    letter-spacing:-.03em;
    min-height:1.8em;      /* reserva 2 renglones */
    display:flex;
    align-items:flex-start;
  }

  .plan__price{
    font-family:var(--font-display);
    font-weight:700;
    font-size:1.3rem;
    letter-spacing:.03em;
    text-transform:uppercase;
    color:var(--violet-soft);
  }

  .plan__features{
    display:grid;
    gap:.6rem;
    align-content:start;
    padding-top:.6rem;
    margin-top:.2rem;
    border-top:1px solid var(--line-soft);
  }
  .plan__features li{
    display:flex;
    gap:.6rem;
    align-items:flex-start;
    font-size:.9rem;
    color:var(--paper-dim);
    line-height:1.5;
  }
  .plan__features svg{
    width:15px; height:15px;
    flex:none;
    margin-top:.28em;
    color:var(--lime);
  }

  .plan__cta{ margin-top:.7rem; width:100%; align-self:end; }

  /* ---------- Ubicación ---------- */
  .place{
    margin-top:clamp(1.6rem,4vw,2.6rem);
    display:grid;
    gap:0;
    border:1px solid var(--line-soft);
    border-radius:var(--r-lg);
    overflow:hidden;
    background:var(--ink-2);
  }

  .place__info{
    display:grid;
    gap:.9rem;
    align-content:center;
    justify-items:start;
    padding:clamp(1.5rem,3.4vw,2.6rem);
  }
  .place__title{ letter-spacing:-.025em; }
  .place__text{ font-size:.93rem; color:var(--paper-dim); max-width:46ch; }

  .place__map{
    position:relative;
    /* Apilado, el alto fijo de 260px dejaba una franja aplastada
       (en tablet llegaba a 811x260). Con aspect-ratio el mapa guarda
       proporcion en cualquier ancho; los topes evitan extremos. */
    aspect-ratio:16/10;
    min-height:240px;
    max-height:420px;
    background:var(--ink-3);
  }
  .place__map iframe{
    position:absolute;
    inset:0;
    width:100%; height:100%;
    border:0;
    filter:grayscale(1) invert(.92) contrast(.86) hue-rotate(180deg);
    transition:filter .6s var(--ease-out);
  }
  /* Solo con puntero real: invertir el mapa al pasar el dedo
     mientras se scrollea seria ruido, no un efecto. */
  @media (hover:hover){
    .place__map:hover iframe{ filter:grayscale(.4) invert(.9) contrast(.9) hue-rotate(180deg); }
  }

  @media (min-width:700px){
    .classes__grid{ grid-template-columns:repeat(2,1fr); }
  }

  @media (min-width:1000px){
    .classes__head{ grid-template-columns:1fr 1fr; align-items:end; }
    .classes__grid{ grid-template-columns:repeat(3,1fr); }
    .place{ grid-template-columns:1fr 1.15fr; }
    .place__map{ aspect-ratio:auto; max-height:none; min-height:340px; }
  }

  @media (max-height:560px) and (orientation:landscape) and (max-width:1000px){
    .classes__grid{ grid-template-columns:repeat(3,1fr); }
    .plan{ padding:1.1rem; }
    .plan__features li{ font-size:.82rem; }
    .place{ grid-template-columns:1fr 1fr; }
    .place__map{ aspect-ratio:auto; max-height:none; min-height:0; }
  }
</style>
