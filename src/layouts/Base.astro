---
import '../styles/global.css';
import { site } from '../data/site.js';

const {
  title = 'Pilates Power Fit | Entrenamiento de alta intensidad en CABA',
  description = 'Esto no es pilates tradicional. Entrenamiento exigente de fuerza, cardio y movilidad en Colegiales, CABA. Método creado por Rosario Santi.',
  image = '/media/hero2.webp',
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
// og:image e twitter:image tienen que ser absolutas: con ruta relativa
// WhatsApp, Facebook e Instagram no muestran la preview al compartir.
const imageUrl = Astro.site ? new URL(image, Astro.site).href : image;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Rosario Santi" />
    <meta name="theme-color" content="#07070A" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <meta name="geo.region" content="AR-C" />
    <meta name="geo.placename" content="Buenos Aires" />

    <link rel="icon" type="image/png" sizes="32x32" href="/media/iconrel.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/media/appleicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SportsActivityLocation',
      name: site.name,
      description,
      address: { '@type': 'PostalAddress', addressLocality: 'Colegiales, CABA', addressCountry: 'AR' },
      sameAs: [site.instagram],
      founder: { '@type': 'Person', name: 'Rosario Santi' },
    })} />
  </head>

  <body>
    <div class="grain" aria-hidden="true"></div>
    <a href="#main" class="skip">Ir al contenido</a>
    <slot />

    <script is:inline>
      // ---------- Siempre arrancar arriba ----------
      // Por defecto el navegador restaura el scroll al recargar, asi que la
      // pagina aparecia ya corrida. Si hay ancla en la URL se respeta.
      (function () {
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        if (window.location.hash) return;
        function top() {
          try { window.scrollTo({ top: 0, left: 0, behavior: 'instant' }); }
          catch (e) { window.scrollTo(0, 0); }
        }
        top();
        window.addEventListener('load', top, { once: true });
      })();

      // ---------- Hover emulado en touch ----------
      // En mobile no hay puntero, asi que los efectos de :hover no se ven
      // nunca. Seguimos el dedo y marcamos con .is-hover lo que hay debajo
      // (el CSS duplica cada regla :hover con esa clase).
      (function () {
        if (!window.matchMedia('(hover: none)').matches) return;

        var SEL = '.btn, .plan, .pillar, .disc, .post, .quote, .rail-btn,' +
                  '.ticket, .ticket__cta, .nav__links a, .nav__logo,' +
                  '.foot__nav a, .foot__link, .foot__agency, .social__handle,' +
                  '.hero__scroll, .founder__frame, .wa-float';

        var current = [];
        var clearTimer = null;
        var pending = null;
        var ticking = false;

        function apply(list) {
          current.forEach(function (el) {
            if (list.indexOf(el) < 0) el.classList.remove('is-hover');
          });
          list.forEach(function (el) {
            if (current.indexOf(el) < 0) el.classList.add('is-hover');
          });
          current = list;
        }

        // Todos los ancestros que coinciden, no solo el mas interno: asi
        // tocar "Reservar" tambien ilumina la tarjeta que lo contiene.
        function chainAt(x, y) {
          var el = document.elementFromPoint(x, y);
          var out = [];
          while (el && el !== document.body) {
            if (el.matches && el.matches(SEL)) out.push(el);
            el = el.parentElement;
          }
          return out;
        }

        function frame() {
          ticking = false;
          if (!pending) return;
          apply(chainAt(pending.x, pending.y));
        }

        function track(e) {
          var t = e.touches && e.touches[0];
          if (!t) return;
          if (clearTimer) { clearTimeout(clearTimer); clearTimer = null; }
          pending = { x: t.clientX, y: t.clientY };
          if (!ticking) { ticking = true; requestAnimationFrame(frame); }
        }

        function release() {
          pending = null;
          if (clearTimer) clearTimeout(clearTimer);
          // Un toque corto dura menos que la transicion: lo sostenemos un
          // momento para que el efecto llegue a verse.
          clearTimer = setTimeout(function () { apply([]); }, 450);
        }

        document.addEventListener('touchstart', track, { passive: true });
        document.addEventListener('touchmove', track, { passive: true });
        document.addEventListener('touchend', release, { passive: true });
        document.addEventListener('touchcancel', release, { passive: true });
      })();

      // ---------- Reveal on scroll ----------
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var items = document.querySelectorAll('[data-reveal]');
        if (reduce || !('IntersectionObserver' in window)) {
          items.forEach(function (el) { el.classList.add('is-in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        items.forEach(function (el) { io.observe(el); });

        // Red de seguridad: nada que ya esté sobre el pliegue queda oculto.
        window.addEventListener('load', function () {
          items.forEach(function (el) {
            if (el.classList.contains('is-in')) return;
            if (el.getBoundingClientRect().top < window.innerHeight) {
              el.classList.add('is-in');
              io.unobserve(el);
            }
          });
        });
      })();

      // ---------- Parallax suave ----------
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var nodes = Array.prototype.slice.call(document.querySelectorAll('[data-parallax]'));
        if (!nodes.length) return;
        var ticking = false;
        function frame() {
          var vh = window.innerHeight;
          nodes.forEach(function (el) {
            var r = el.getBoundingClientRect();
            if (r.bottom < -200 || r.top > vh + 200) return;
            var speed = parseFloat(el.dataset.parallax) || 0.12;
            var offset = (r.top + r.height / 2 - vh / 2) * speed * -1;
            el.style.setProperty('--py', offset.toFixed(1) + 'px');
          });
          ticking = false;
        }
        function onScroll() {
          if (!ticking) { ticking = true; requestAnimationFrame(frame); }
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        frame();
      })();
    </script>

    <style is:global>
      .skip{
        position:fixed; top:-100px; left:12px; z-index:200;
        background:var(--lime); color:var(--ink);
        padding:.6rem 1rem; border-radius:8px; font-weight:700;
        transition:top .25s var(--ease-out);
      }
      .skip:focus{ top:12px; }
    </style>
  </body>
</html>
